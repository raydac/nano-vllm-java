<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.igormaznitsa</groupId>
        <artifactId>nano-vllm-java-pom</artifactId>
        <version>1.5.0-SNAPSHOT</version>
    </parent>

    <artifactId>nano-vllm-java-samples</artifactId>
    <name>nano-vllm-java-samples</name>
    <description>Sample applications and demos for nano-vllm-java</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <exec.mainClass>com.igormaznitsa.nanollvm.samples.Example</exec.mainClass>
        <tornado.launcher>tornado</tornado.launcher>
        <tornado.executable>${tornado.launcher}</tornado.executable>
        <tornado.exec.skip>true</tornado.exec.skip>
        <tornado.params></tornado.params>
        <!-- TornadoVM child JVM; override when Maven's JAVA_HOME is not the TornadoVM JDK. -->
        <tornado.java.home>${java.home}</tornado.java.home>
        <tornado.jvm.args>-Dnanollvm.kernels=tornado -Dtornado.enabled.backends=OpenCL
            --add-modules=jdk.incubator.vector -Xmx16g
        </tornado.jvm.args>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.beehive-lab</groupId>
            <artifactId>tornado-api</artifactId>
            <version>${tornadovm.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.beehive-lab</groupId>
            <artifactId>tornado-runtime</artifactId>
            <version>${tornadovm.version}</version>
        </dependency>
        <dependency>
            <groupId>com.igormaznitsa</groupId>
            <artifactId>nano-vllm-java</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.profiler</groupId>
            <artifactId>async-profiler</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Run a sample under the TornadoVM launcher (`tornado` on PATH, `tornado.exe` on Windows).
          When `TORNADOVM_HOME` is set, the executable is `$TORNADOVM_HOME/bin/<launcher>`.
          Uses the SDK runtime/modules — not the Maven Central tornado jars — so the installed
          TornadoVM 8.0.0 distribution (e.g. OpenCL) drives accelerators.
          Install libclblast so a multi-token dense GEMV uses CLBlast.

            mvn -pl nano-vllm-java-samples -am -Ptornado compile exec:exec@tornado \
              -Dtornado.java.home=/path/to/jdk-22
            mvn -pl nano-vllm-java-samples -am -Ptornado compile exec:exec@tornado \
              -Dtornado.java.home=/path/to/jdk-22 -Dtornado.params="models/Gemma3-270M"
            mvn -pl nano-vllm-java-samples -am -Ptornado compile exec:exec@tornado \
              -Dtornado.java.home=/path/to/jdk-22 \
              -Dexec.mainClass=com.igormaznitsa.nanollvm.samples.KernelChatBench
        -->
        <profile>
            <id>tornado</id>
            <properties>
                <tornado.exec.skip>false</tornado.exec.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>tornado</id>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${tornado.exec.skip}</skip>
                                    <executable>${tornado.executable}</executable>
                                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                                    <environmentVariables>
                                        <JAVA_HOME>${tornado.java.home}</JAVA_HOME>
                                    </environmentVariables>
                                    <arguments>
                                        <argument>--classpath</argument>
                                        <argument>
                                            ${project.build.outputDirectory}${path.separator}${maven.multiModuleProjectDirectory}/nano-vllm-java/target/classes
                                        </argument>
                                        <argument>--jvm=${tornado.jvm.args}</argument>
                                        <argument>--params=${tornado.params}</argument>
                                        <argument>${exec.mainClass}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
          Fork Bench and sample the timed generate with async-profiler.
          Invoke package in the same Maven command so the classpath is this build's jar,
          not an older snapshot from the local repository.
          Reports land in nano-vllm-java-samples/target/bench-profile/.

            mvn22 -pl nano-vllm-java-samples -am -Pbench package exec:exec@bench
            mvn22 -pl nano-vllm-java-samples -am -Pbench package exec:exec@bench -Dbench.kernels=vector
            mvn22 -pl nano-vllm-java-samples -am -Pbench package exec:exec@bench -Dbench.kernels=scalar -Dbench.seqs=1 -Dbench.maxInput=32 -Dbench.maxOutput=8

          bench.kernels: scalar (default), vector, auto, tornado.
          bench.event: cpu (default), wall, alloc, lock, itimer.
        -->
        <profile>
            <id>bench</id>
            <properties>
                <bench.exec.skip>false</bench.exec.skip>
                <bench.kernels>scalar</bench.kernels>
                <bench.event>cpu</bench.event>
                <bench.interval>10000000</bench.interval>
                <bench.model>models/Qwen3-0.6B</bench.model>
                <bench.seqs>8</bench.seqs>
                <bench.maxInput></bench.maxInput>
                <bench.maxOutput></bench.maxOutput>
                <bench.profile.file>${project.build.directory}/bench-profile/bench-${bench.kernels}</bench.profile.file>
                <bench.executable>java</bench.executable>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>bench</id>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${bench.exec.skip}</skip>
                                    <executable>${bench.executable}</executable>
                                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                                    <longClasspath>true</longClasspath>
                                    <arguments>
                                        <argument>-Xmx16g</argument>
                                        <argument>--add-modules=jdk.incubator.vector</argument>
                                        <argument>--enable-native-access=ALL-UNNAMED</argument>
                                        <argument>-Dnanollvm.kernels=${bench.kernels}</argument>
                                        <argument>-Dnanollvm.profile=${bench.event}</argument>
                                        <argument>-Dnanollvm.profile.interval=${bench.interval}</argument>
                                        <argument>-Dnanollvm.profile.file=${bench.profile.file}</argument>
                                        <argument>-Dnanollvm.bench.maxInput=${bench.maxInput}</argument>
                                        <argument>-Dnanollvm.bench.maxOutput=${bench.maxOutput}</argument>
                                        <argument>-classpath</argument>
                                        <classpath/>
                                        <argument>com.igormaznitsa.nanollvm.samples.Bench</argument>
                                        <argument>${bench.model}</argument>
                                        <argument>${bench.seqs}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <tornado.launcher>tornado.exe</tornado.launcher>
                <tornado.executable>${tornado.launcher}</tornado.executable>
            </properties>
        </profile>
        <profile>
            <id>tornadovm-home</id>
            <activation>
                <property>
                    <name>env.TORNADOVM_HOME</name>
                </property>
            </activation>
            <properties>
                <tornado.executable>${env.TORNADOVM_HOME}/bin/${tornado.launcher}</tornado.executable>
            </properties>
        </profile>
    </profiles>
</project>
